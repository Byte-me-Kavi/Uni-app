# Copy to .env.local and fill in. Never commit .env.local.
# Only publishable values belong here: anything EXPO_PUBLIC_* is bundled into the app.

# Local Supabase (from `supabase start`) or the staging project (Supabase dashboard > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the Cloudflare R2 bucket that serves profile photos (r2.dev or a custom domain).
EXPO_PUBLIC_MEDIA_URL=
